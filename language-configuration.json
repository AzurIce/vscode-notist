{
	"comments": {
		"lineComment": "//",
		"blockComment": ["/*", "*/"]
	},
	"brackets": [
		["[", "]"],
		["(", ")"],
		["{", "}"]
	],
	"autoClosingPairs": [
		{ "open": "[", "close": "]" },
		{ "open": "(", "close": ")" },
		{ "open": "{", "close": "}" },
		{ "open": "\"", "close": "\"", "notIn": ["string"] },
		{ "open": "`", "close": "`", "notIn": ["string"] }
	],
	"surroundingPairs": [
		["[", "]"],
		["(", ")"],
		["{", "}"],
		["\"", "\""],
		["`", "`"],
		["*", "*"],
		["_", "_"]
	],
	"wordPattern": "(-?\\p{L}[\\p{L}\\p{N}_-]*)|(\\p{N}+)"
}
